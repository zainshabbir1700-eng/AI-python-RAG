# Supabase API & Storage Configuration
SUPABASE_PROJECT_REF=your_supabase_project_ref
SUPABASE_URL=https://your-project-ref.supabase.co
# Retrieve your Project API Key from: Project Settings -> API (Anon or Service Role)
SUPABASE_KEY=your_supabase_anon_or_service_role_key
SUPABASE_BUCKET=kyc-documents

# Supabase PostgreSQL Database Configuration
DIRECT_HOST=db.your-project-ref.supabase.co
POOLER_HOST=aws-0-ap-south-1.pooler.supabase.com
POOLER_PORT=5432
DATABASE_NAME=postgres
POOLER_USER=postgres.your_supabase_project_ref
DATABASE_PASSWORD=your_db_password_here
DATABASE_URL=postgresql://postgres.your_project_ref:your_encoded_password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# Tesseract OCR Configuration (Optional custom path if not on system PATH)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
